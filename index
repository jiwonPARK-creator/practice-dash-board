<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>도형의 마술: 삼각형의 합동조건</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js?config=TeX-MML-AM_CHTML"></script>
    
    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            scroll-behavior: smooth;
        }

        /* Gradient Text */
        .text-gradient {
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-image: linear-gradient(to right, #4F46E5, #EC4899);
        }

        /* Card Hover Effects */
        .condition-card {
            transition: all 0.3s ease;
        }
        .condition-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        /* Canvas container for drawing triangles */
        .canvas-container {
            position: relative;
            width: 100%;
            padding-bottom: 75%; /* 4:3 Aspect Ratio */
            background-color: #f8fafc;
            border-radius: 0.5rem;
            overflow: hidden;
            border: 2px dashed #cbd5e1;
            transition: border-color 0.3s;
        }
        
        .canvas-container:hover {
            border-color: #94a3b8;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #c7d2fe; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #818cf8; 
        }
        
        /* Floating animation for intro shapes */
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(10deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
        .floating-shape {
            animation: float 6s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased selection:bg-indigo-200 selection:text-indigo-900">

    <!-- Navigation -->
    <nav class="fixed w-full bg-white/80 backdrop-blur-md z-50 border-b border-gray-100 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex-shrink-0 flex items-center cursor-pointer" onclick="window.scrollTo(0,0)">
                    <i class="fas fa-shapes text-indigo-600 text-2xl mr-2"></i>
                    <span class="font-bold text-xl tracking-tight text-gray-900">중1 수학 탐험</span>
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="#intro" class="text-gray-600 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">합동이란?</a>
                    <a href="#conditions" class="text-gray-600 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium transition-colors">3가지 조건</a>
                    <a href="#interactive" class="bg-indigo-600 text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-indigo-700 transition-colors shadow-sm">직접 해보기</a>
                </div>
                <!-- Mobile menu button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-600 hover:text-gray-900 focus:outline-none p-2">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-100 absolute w-full">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="#intro" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50">합동이란?</a>
                <a href="#conditions" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50">3가지 조건</a>
                <a href="#interactive" class="block px-3 py-2 rounded-md text-base font-medium text-indigo-600 hover:bg-indigo-50">직접 해보기</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-50"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            
            <!-- Decorative Background Elements -->
            <div class="absolute top-0 left-1/4 w-32 h-32 bg-indigo-200 rounded-full mix-blend-multiply filter blur-2xl opacity-70 animate-blob floating-shape"></div>
            <div class="absolute top-0 right-1/4 w-32 h-32 bg-pink-200 rounded-full mix-blend-multiply filter blur-2xl opacity-70 animate-blob animation-delay-2000 floating-shape" style="animation-delay: 2s;"></div>
            <div class="absolute -bottom-8 left-1/2 w-32 h-32 bg-yellow-200 rounded-full mix-blend-multiply filter blur-2xl opacity-70 animate-blob animation-delay-4000 floating-shape" style="animation-delay: 4s;"></div>

            <span class="inline-block py-1 px-3 rounded-full bg-indigo-100 text-indigo-800 text-sm font-semibold tracking-wider mb-4 border border-indigo-200">
                중학교 1학년 2학기 도형
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 text-gray-900">
                쌍둥이 삼각형의 비밀<br>
                <span class="text-gradient">삼각형의 합동조건</span>
            </h1>
            <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-600 mb-8 leading-relaxed">
                모양과 크기가 똑같아 완벽하게 포개어지는 두 삼각형! <br class="hidden sm:block">
                어떤 조건이 맞아야 완벽한 '합동'이 될 수 있을까요? 지금부터 그 마법 같은 공식을 파헤쳐 봅니다.
            </p>
            <div class="flex justify-center gap-4">
                <a href="#conditions" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-white bg-indigo-600 hover:bg-indigo-700 md:text-lg shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
                    비밀 풀기 시작 <i class="fas fa-arrow-down ml-2"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Intro Section: What is Congruence? -->
    <section id="intro" class="py-16 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-indigo-50 rounded-3xl p-8 sm:p-12 relative overflow-hidden shadow-sm border border-indigo-100">
                <div class="absolute top-0 right-0 -mr-8 -mt-8 text-indigo-100 opacity-50">
                    <i class="fas fa-clone text-9xl"></i>
                </div>
                <div class="relative z-10">
                    <h2 class="text-3xl font-bold text-gray-900 mb-4 flex items-center">
                        <span class="bg-indigo-600 text-white w-10 h-10 rounded-full inline-flex items-center justify-center mr-3 text-xl shadow-md">
                            <i class="fas fa-question"></i>
                        </span>
                        '합동'이 뭐예요?
                    </h2>
                    <p class="text-lg text-gray-700 leading-relaxed mb-6">
                        수학에서 <strong>'합동(Congruence)'</strong>이란, 두 도형의 <strong>모양과 크기가 똑같아서</strong> 한 도형을 다른 도형 위에 놓았을 때 <strong>완벽하게 겹쳐지는 것</strong>을 말해요. 데칼코마니나 도장을 찍은 것처럼 말이죠!
                    </p>
                    <div class="bg-white p-6 rounded-2xl shadow-inner border border-gray-100">
                        <p class="text-gray-800 font-medium mb-2">기호로는 어떻게 쓸까요?</p>
                        <p class="text-xl">
                            <span class="text-indigo-600 font-bold">\(\triangle \text{ABC} \equiv \triangle \text{DEF}\)</span>
                        </p>
                        <p class="text-sm text-gray-500 mt-2">
                            * 주의: '=' 기호는 '넓이가 같다'는 뜻이므로, 합동일 때는 반드시 작대기 3개짜리 '\(\equiv\)'를 써야 해요!
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content: The 3 Conditions -->
    <section id="conditions" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-indigo-600 font-semibold tracking-wide uppercase text-sm">핵심 개념</h2>
                <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                    삼각형이 합동이 되기 위한 3가지 마법 주문
                </p>
                <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">
                    세 가지만 기억하세요. S는 변(Side), A는 각(Angle)을 뜻합니다.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- SSS 합동 -->
                <div class="bg-white rounded-2xl p-8 shadow-md condition-card border border-gray-100 relative overflow-hidden group">
                    <div class="absolute top-0 left-0 w-full h-2 bg-blue-500 transform origin-left transition-transform group-hover:scale-x-100"></div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-2xl font-bold text-gray-900">SSS 합동</h3>
                        <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Side-Side-Side</span>
                    </div>
                    <p class="text-gray-600 mb-6 min-h-[4rem]">
                        <strong>세 쌍의 대응변</strong>의 길이가 각각 같을 때.
                    </p>
                    
                    <!-- Visual Representation -->
                    <div class="aspect-w-4 aspect-h-3 mb-6 bg-slate-50 rounded-xl flex items-center justify-center p-4 border border-slate-100">
                        <svg viewBox="0 0 200 100" class="w-full h-full drop-shadow-md">
                            <!-- Triangle 1 -->
                            <polygon points="10,80 50,20 90,80" fill="#DBEAFE" stroke="#3B82F6" stroke-width="2"/>
                            <!-- Markings -->
                            <line x1="25" y1="50" x2="35" y2="50" stroke="#EF4444" stroke-width="2"/>
                            <line x1="65" y1="50" x2="75" y2="50" stroke="#EF4444" stroke-width="2"/>
                            <line x1="68" y1="53" x2="78" y2="53" stroke="#EF4444" stroke-width="2"/>
                            <line x1="45" y1="80" x2="45" y2="90" stroke="#EF4444" stroke-width="2"/>
                            <line x1="50" y1="80" x2="50" y2="90" stroke="#EF4444" stroke-width="2"/>
                            <line x1="55" y1="80" x2="55" y2="90" stroke="#EF4444" stroke-width="2"/>
                            
                            <text x="50" y="55" text-anchor="middle" font-size="20" fill="#3B82F6">≡</text>

                            <!-- Triangle 2 -->
                            <polygon points="110,80 150,20 190,80" fill="#DBEAFE" stroke="#3B82F6" stroke-width="2"/>
                            <!-- Markings -->
                            <line x1="125" y1="50" x2="135" y2="50" stroke="#EF4444" stroke-width="2"/>
                            <line x1="165" y1="50" x2="175" y2="50" stroke="#EF4444" stroke-width="2"/>
                            <line x1="168" y1="53" x2="178" y2="53" stroke="#EF4444" stroke-width="2"/>
                            <line x1="145" y1="80" x2="145" y2="90" stroke="#EF4444" stroke-width="2"/>
                            <line x1="150" y1="80" x2="150" y2="90" stroke="#EF4444" stroke-width="2"/>
                            <line x1="155" y1="80" x2="155" y2="90" stroke="#EF4444" stroke-width="2"/>
                        </svg>
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-lg text-sm text-gray-700">
                        <ul class="space-y-1 font-mono text-center">
                            <li>AB = A'B' <span class="text-blue-500 font-bold">(S)</span></li>
                            <li>BC = B'C' <span class="text-blue-500 font-bold">(S)</span></li>
                            <li>CA = C'A' <span class="text-blue-500 font-bold">(S)</span></li>
                        </ul>
                    </div>
                </div>

                <!-- SAS 합동 -->
                <div class="bg-white rounded-2xl p-8 shadow-md condition-card border border-gray-100 relative overflow-hidden group">
                    <div class="absolute top-0 left-0 w-full h-2 bg-pink-500 transform origin-left transition-transform group-hover:scale-x-100"></div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-2xl font-bold text-gray-900">SAS 합동</h3>
                        <span class="bg-pink-100 text-pink-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Side-Angle-Side</span>
                    </div>
                    <p class="text-gray-600 mb-6 min-h-[4rem]">
                        <strong>두 쌍의 대응변</strong>의 길이가 같고, 그 <strong>끼인가각</strong>의 크기가 같을 때.
                    </p>
                    
                    <!-- Visual Representation -->
                    <div class="aspect-w-4 aspect-h-3 mb-6 bg-slate-50 rounded-xl flex items-center justify-center p-4 border border-slate-100">
                        <svg viewBox="0 0 200 100" class="w-full h-full drop-shadow-md">
                            <!-- Triangle 1 -->
                            <polygon points="10,80 10,20 80,80" fill="#FCE7F3" stroke="#EC4899" stroke-width="2"/>
                            <!-- Markings -->
                            <line x1="5" y1="50" x2="15" y2="50" stroke="#3B82F6" stroke-width="2"/> <!-- Side -->
                            <path d="M 10 65 A 15 15 0 0 0 25 80" fill="none" stroke="#F59E0B" stroke-width="2"/> <!-- Angle -->
                            <line x1="45" y1="75" x2="45" y2="85" stroke="#3B82F6" stroke-width="2"/> <!-- Side -->
                            <line x1="48" y1="75" x2="48" y2="85" stroke="#3B82F6" stroke-width="2"/>
                            
                            <text x="95" y="55" text-anchor="middle" font-size="20" fill="#EC4899">≡</text>

                            <!-- Triangle 2 -->
                            <polygon points="110,80 110,20 180,80" fill="#FCE7F3" stroke="#EC4899" stroke-width="2"/>
                            <!-- Markings -->
                            <line x1="105" y1="50" x2="115" y2="50" stroke="#3B82F6" stroke-width="2"/>
                            <path d="M 110 65 A 15 15 0 0 0 125 80" fill="none" stroke="#F59E0B" stroke-width="2"/>
                            <line x1="145" y1="75" x2="145" y2="85" stroke="#3B82F6" stroke-width="2"/>
                            <line x1="148" y1="75" x2="148" y2="85" stroke="#3B82F6" stroke-width="2"/>
                        </svg>
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-lg text-sm text-gray-700">
                        <ul class="space-y-1 font-mono text-center">
                            <li>AB = A'B' <span class="text-pink-500 font-bold">(S)</span></li>
                            <li>∠B = ∠B' <span class="text-amber-500 font-bold">(A)</span> (끼인가)</li>
                            <li>BC = B'C' <span class="text-pink-500 font-bold">(S)</span></li>
                        </ul>
                    </div>
                </div>

                <!-- ASA 합동 -->
                <div class="bg-white rounded-2xl p-8 shadow-md condition-card border border-gray-100 relative overflow-hidden group">
                    <div class="absolute top-0 left-0 w-full h-2 bg-amber-500 transform origin-left transition-transform group-hover:scale-x-100"></div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-2xl font-bold text-gray-900">ASA 합동</h3>
                        <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Angle-Side-Angle</span>
                    </div>
                    <p class="text-gray-600 mb-6 min-h-[4rem]">
                        <strong>한 쌍의 대응변</strong>의 길이가 같고, 그 <strong>양 끝각</strong>의 크기가 각각 같을 때.
                    </p>
                    
                    <!-- Visual Representation -->
                    <div class="aspect-w-4 aspect-h-3 mb-6 bg-slate-50 rounded-xl flex items-center justify-center p-4 border border-slate-100">
                        <svg viewBox="0 0 200 100" class="w-full h-full drop-shadow-md">
                            <!-- Triangle 1 -->
                            <polygon points="20,80 50,30 80,80" fill="#FEF3C7" stroke="#F59E0B" stroke-width="2"/>
                            <!-- Markings -->
                            <path d="M 35 80 A 15 15 0 0 1 28 65" fill="none" stroke="#EC4899" stroke-width="2"/> <!-- Angle 1 -->
                            <line x1="50" y1="75" x2="50" y2="85" stroke="#3B82F6" stroke-width="2"/> <!-- Side -->
                            <path d="M 80 65 A 15 15 0 0 0 65 80" fill="none" stroke="#EC4899" stroke-width="2"/> <!-- Angle 2 -->
                            <path d="M 77 65 A 18 18 0 0 0 62 80" fill="none" stroke="#EC4899" stroke-width="2"/>
                            
                            <text x="100" y="55" text-anchor="middle" font-size="20" fill="#F59E0B">≡</text>

                            <!-- Triangle 2 -->
                            <polygon points="120,80 150,30 180,80" fill="#FEF3C7" stroke="#F59E0B" stroke-width="2"/>
                            <!-- Markings -->
                            <path d="M 135 80 A 15 15 0 0 1 128 65" fill="none" stroke="#EC4899" stroke-width="2"/>
                            <line x1="150" y1="75" x2="150" y2="85" stroke="#3B82F6" stroke-width="2"/>
                            <path d="M 180 65 A 15 15 0 0 0 165 80" fill="none" stroke="#EC4899" stroke-width="2"/>
                            <path d="M 177 65 A 18 18 0 0 0 162 80" fill="none" stroke="#EC4899" stroke-width="2"/>
                        </svg>
                    </div>
                    
                    <div class="bg-gray-50 p-4 rounded-lg text-sm text-gray-700">
                        <ul class="space-y-1 font-mono text-center">
                            <li>∠B = ∠B' <span class="text-amber-500 font-bold">(A)</span></li>
                            <li>BC = B'C' <span class="text-blue-500 font-bold">(S)</span> (양 끝각 사이)</li>
                            <li>∠C = ∠C' <span class="text-amber-500 font-bold">(A)</span></li>
                        </ul>
                    </div>
                </div>

            </div>
            
            <div class="mt-12 bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r-lg shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-triangle text-yellow-400"></i>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-yellow-800">함정 주의!</h3>
                        <div class="mt-2 text-sm text-yellow-700">
                            <p><strong>AAA (세 각이 같음)</strong>이나 <strong>SSA (두 변과 끼인각이 아닌 각이 같음)</strong>는 합동 조건이 <strong>아닙니다!</strong> 세 각이 같으면 크기가 다른 '닮은' 삼각형이 될 수 있어요.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Section -->
    <section id="interactive" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
                    직접 만들어보는 합동 삼각형
                </h2>
                <p class="mt-4 text-lg text-gray-500">
                    아래 슬라이더를 조절하여 조건을 만족하는 두 삼각형이 어떻게 똑같이 변하는지 관찰해보세요.
                </p>
            </div>

            <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-200">
                <div class="grid grid-cols-1 lg:grid-cols-3">
                    
                    <!-- Controls Panel -->
                    <div class="bg-gray-50 p-6 lg:border-r border-gray-200 lg:col-span-1 flex flex-col gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">합동 조건 선택</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button id="btn-sss" class="cond-btn bg-indigo-600 text-white py-2 px-4 rounded-md text-sm font-medium transition-colors">SSS</button>
                                <button id="btn-sas" class="cond-btn bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 py-2 px-4 rounded-md text-sm font-medium transition-colors">SAS</button>
                                <button id="btn-asa" class="cond-btn bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 py-2 px-4 rounded-md text-sm font-medium transition-colors">ASA</button>
                            </div>
                        </div>

                        <!-- Sliders for SSS -->
                        <div id="controls-sss" class="space-y-4">
                            <h4 class="font-bold text-gray-800 border-b pb-2">변의 길이 조절 (SSS)</h4>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>변 a (밑변)</span> <span id="val-a" class="font-mono text-indigo-600 font-bold">200</span>
                                </label>
                                <input type="range" id="slider-a" min="100" max="300" value="200" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-indigo-600">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>변 b (왼쪽)</span> <span id="val-b" class="font-mono text-indigo-600 font-bold">150</span>
                                </label>
                                <input type="range" id="slider-b" min="100" max="250" value="150" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-indigo-600">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>변 c (오른쪽)</span> <span id="val-c" class="font-mono text-indigo-600 font-bold">180</span>
                                </label>
                                <input type="range" id="slider-c" min="100" max="250" value="180" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-indigo-600">
