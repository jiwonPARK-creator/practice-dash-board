                        </div>

                        <!-- Sliders for SAS -->
                        <div id="controls-sas" class="space-y-4 hidden">
                            <h4 class="font-bold text-gray-800 border-b pb-2">변과 끼인각 조절 (SAS)</h4>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>변 a (밑변)</span> <span id="val-sas-a" class="font-mono text-pink-600 font-bold">200</span>
                                </label>
                                <input type="range" id="slider-sas-a" min="100" max="300" value="200" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-pink-600">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>끼인각 (왼쪽 각)</span> <span id="val-sas-angle" class="font-mono text-pink-600 font-bold">60°</span>
                                </label>
                                <input type="range" id="slider-sas-angle" min="20" max="150" value="60" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-pink-600">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>변 b (왼쪽)</span> <span id="val-sas-b" class="font-mono text-pink-600 font-bold">150</span>
                                </label>
                                <input type="range" id="slider-sas-b" min="100" max="250" value="150" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-pink-600">
                            </div>
                        </div>

                        <!-- Sliders for ASA -->
                        <div id="controls-asa" class="space-y-4 hidden">
                            <h4 class="font-bold text-gray-800 border-b pb-2">양 끝각과 변 조절 (ASA)</h4>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>왼쪽 각</span> <span id="val-asa-ang1" class="font-mono text-amber-600 font-bold">50°</span>
                                </label>
                                <input type="range" id="slider-asa-ang1" min="20" max="120" value="50" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-amber-500">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>변 a (밑변)</span> <span id="val-asa-a" class="font-mono text-amber-600 font-bold">200</span>
                                </label>
                                <input type="range" id="slider-asa-a" min="100" max="300" value="200" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-amber-500">
                            </div>
                            <div>
                                <label class="flex justify-between text-sm text-gray-600">
                                    <span>오른쪽 각</span> <span id="val-asa-ang2" class="font-mono text-amber-600 font-bold">60°</span>
                                </label>
                                <input type="range" id="slider-asa-ang2" min="20" max="120" value="60" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-amber-500">
