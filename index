    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-gray-400 text-sm">
                &copy; 2026 중1 수학 탐험. 본 페이지는 중학교 1학년 수학 교육용으로 제작되었습니다.
            </p>
            <div class="mt-4 flex justify-center space-x-4">
                <a href="#" class="text-gray-400 hover:text-white transition-colors"><i class="fas fa-home"></i></a>
                <a href="#" class="text-gray-400 hover:text-white transition-colors"><i class="fas fa-envelope"></i></a>
            </div>
        </div>
    </footer>

    <!-- JavaScript for Interactivity and Canvas Drawing -->
    <script>
        // DOM Elements
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const navbar = document.getElementById('navbar');
        
        // Mobile Menu Toggle
        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Navbar shrink on scroll
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('shadow-md', 'py-1');
            } else {
                navbar.classList.remove('shadow-md', 'py-1');
            }
        });

        // Canvas Setup
        const canvas = document.getElementById('triCanvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        function resizeCanvas() {
            const container = canvas.parentElement;
            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight;
            width = canvas.width;
            height = canvas.height;
            drawTriangles(); // Redraw on resize
        }

        window.addEventListener('resize', resizeCanvas);

        // State variables
        let currentMode = 'sss'; // sss, sas, asa
        let isOverlapping = false;
        
        // Colors
        const colorT1 = 'rgba(79, 70, 229, 0.2)'; // Indigo light
        const strokeT1 = '#4F46E5';
        const colorT2 = 'rgba(236, 72, 153, 0.2)'; // Pink light
        const strokeT2 = '#EC4899';
        
        const markColor = '#1F2937';

        // UI Buttons
        const btns = {
            sss: document.getElementById('btn-sss'),
            sas: document.getElementById('btn-sas'),
            asa: document.getElementById('btn-asa')
        };
        const controls = {
            sss: document.getElementById('controls-sss'),
            sas: document.getElementById('controls-sas'),
            asa: document.getElementById('controls-asa')
        };
        const canvasTitle = document.getElementById('canvas-title');

        // Mode Switching
        function setMode(mode) {
            currentMode = mode;
            // Update buttons visually
            for(let key in btns) {
                if(key === mode) {
                    btns[key].className = 'cond-btn bg-indigo-600 text-white py-2 px-4 rounded-md text-sm font-medium transition-colors';
                } else {
                    btns[key].className = 'cond-btn bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 py-2 px-4 rounded-md text-sm font-medium transition-colors';
                }
            }
            // Toggle control panels
            for(let key in controls) {
                controls[key].classList.toggle('hidden', key !== mode);
            }
            
            // Update Title
            MathJax.Hub.Queue(["Typeset", MathJax.Hub, canvasTitle]);
            if(mode === 'sss') canvasTitle.innerHTML = '\\(\\triangle ABC \\equiv \\triangle DEF\\) (SSS 합동)';
            if(mode === 'sas') canvasTitle.innerHTML = '\\(\\triangle ABC \\equiv \\triangle DEF\\) (SAS 합동)';
            if(mode === 'asa') canvasTitle.innerHTML = '\\(\\triangle ABC \\equiv \\triangle DEF\\) (ASA 합동)';
            
            MathJax.Hub.Queue(["Typeset", MathJax.Hub, canvasTitle]);
            
            drawTriangles();
        }

        btns.sss.addEventListener('click', () => setMode('sss'));
        btns.sas.addEventListener('click', () => setMode('sas'));
        btns.asa.addEventListener('click', () => setMode('asa'));

        document.getElementById('toggle-overlap').addEventListener('change', (e) => {
            isOverlapping = e.target.checked;
            
            // Animate overlap transition
            let progress = 0;
            const animate = () => {
                progress += 0.05;
                if(progress > 1) progress = 1;
                drawTriangles(isOverlapping ? progress : 1 - progress);
                if(progress < 1) requestAnimationFrame(animate);
            };
            requestAnimationFrame(animate);
        });

        // SSS Sliders
        const s_a = document.getElementById('slider-a');
        const s_b = document.getElementById('slider-b');
        const s_c = document.getElementById('slider-c');
        const err_sss = document.getElementById('sss-error');

        [s_a, s_b, s_c].forEach(el => el.addEventListener('input', () => {
            document.getElementById('val-a').innerText = s_a.value;
            document.getElementById('val-b').innerText = s_b.value;
            document.getElementById('val-c').innerText = s_c.value;
            drawTriangles();
        }));

        // SAS Sliders
        const sas_a = document.getElementById('slider-sas-a');
        const sas_angle = document.getElementById('slider-sas-angle');
        const sas_b = document.getElementById('slider-sas-b');
        
        [sas_a, sas_angle, sas_b].forEach(el => el.addEventListener('input', () => {
            document.getElementById('val-sas-a').innerText = sas_a.value;
            document.getElementById('val-sas-angle').innerText = sas_angle.value + '°';
            document.getElementById('val-sas-b').innerText = sas_b.value;
            drawTriangles();
        }));

        // ASA Sliders
        const asa_ang1 = document.getElementById('slider-asa-ang1');
        const asa_a = document.getElementById('slider-asa-a');
        const asa_ang2 = document.getElementById('slider-asa-ang2');
        const err_asa = document.getElementById('asa-error');

        [asa_ang1, asa_a, asa_ang2].forEach(el => el.addEventListener('input', () => {
            document.getElementById('val-asa-ang1').innerText = asa_ang1.value + '°';
            document.getElementById('val-asa-a').innerText = asa_a.value;
            document.getElementById('val-asa-ang2').innerText = asa_ang2.value + '°';
            drawTriangles();
        }));

        // --- Math Helpers ---
        // Calculate 3rd vertex given 3 sides (base is on x-axis)
        function calcVertexSSS(a, b, c) {
            // Check triangle inequality
            if (a + b <= c || a + c <= b || b + c <= a) return null;
            
            // Using Law of Cosines to find x and y of vertex C
            // b^2 = x^2 + y^2
            // c^2 = (a-x)^2 + y^2 = a^2 - 2ax + x^2 + y^2 = a^2 - 2ax + b^2
            // 2ax = a^2 + b^2 - c^2
            let x = (a*a + b*b - c*c) / (2*a);
            let y = Math.sqrt(b*b - x*x);
            return {x: x, y: y};
        }

        // Calculate 3rd vertex given 2 sides and included angle (deg)
        function calcVertexSAS(a, angleDeg, b) {
            let angleRad = angleDeg * Math.PI / 180;
            let x = b * Math.cos(angleRad);
            let y = b * Math.sin(angleRad);
            return {x: x, y: y};
        }

        // Calculate 3rd vertex given 1 side and 2 adjacent angles (deg)
        function calcVertexASA(angle1Deg, a, angle2Deg) {
            if (angle1Deg + angle2Deg >= 180) return null;
            
            let A = angle1Deg * Math.PI / 180;
            let B = angle2Deg * Math.PI / 180;
            
            // Using Law of Sines
            // c / sin(C) = b / sin(B) = a / sin(A) (angles are A, B, C; sides opposite are a,b,c)
            // Here: base is length 'a'. Angles at ends are A and B. Angle at top is C = 180 - (A+B)
            let C = Math.PI - (A + B);
            
            // side 'b' is opposite to angle B
            let b = (a * Math.sin(B)) / Math.sin(C);
            
            let x = b * Math.cos(A);
            let y = b * Math.sin(A);
            
            return {x: x, y: y};
        }

        // Draw a single triangle
        function drawTriangle(ctx, pts, color, stroke, labels, isOverlay = false) {
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            ctx.lineTo(pts[1].x, pts[1].y);
            ctx.lineTo(pts[2].x, pts[2].y);
            ctx.closePath();
            
            ctx.fillStyle = color;
            ctx.fill();
            ctx.lineWidth = 3;
            ctx.strokeStyle = stroke;
            ctx.stroke();

            // Labels
            ctx.fillStyle = '#111827';
            ctx.font = 'bold 16px Noto Sans KR';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            
            // Offset logic for labels
            const offset = 20;
            ctx.fillText(labels[0], pts[0].x - offset, pts[0].y + offset); // Bottom Left (B/E)
            ctx.fillText(labels[1], pts[1].x + offset, pts[1].y + offset); // Bottom Right (C/F)
            ctx.fillText(labels[2], pts[2].x, pts[2].y - offset); // Top (A/D)
        }

        // Draw Markings (Sides or Angles)
        function drawSideMark(ctx, p1, p2, type, stroke) {
            const mx = (p1.x + p2.x) / 2;
            const my = (p1.y + p2.y) / 2;
            const angle = Math.atan2(p2.y - p1.y, p2.x - p1.x);
            
            ctx.save();
            ctx.translate(mx, my);
            ctx.rotate(angle + Math.PI/2);
            
            ctx.strokeStyle = '#1F2937';
            ctx.lineWidth = 2;
            ctx.beginPath();
            
            if(type === 1) {
                ctx.moveTo(-5, 0); ctx.lineTo(5, 0);
            } else if (type === 2) {
                ctx.moveTo(-5, -3); ctx.lineTo(5, -3);
                ctx.moveTo(-5, 3); ctx.lineTo(5, 3);
            } else if (type === 3) {
                ctx.moveTo(-5, -5); ctx.lineTo(5, -5);
                ctx.moveTo(-5, 0); ctx.lineTo(5, 0);
                ctx.moveTo(-5, 5); ctx.lineTo(5, 5);
            }
            ctx.stroke();
            ctx.restore();
        }

        function drawAngleMark(ctx, p_vertex, p1, p2, radius, numArcs) {
            const a1 = Math.atan2(p1.y - p_vertex.y, p1.x - p_vertex.x);
            const a2 = Math.atan2(p2.y - p_vertex.y, p2.x - p_vertex.x);
            
            // Ensure draw in shortest direction
            let start = a1;
            let end = a2;
            if (end < start) end += Math.PI * 2;
            
            // Small correction to draw inside the triangle depending on winding
            
            ctx.strokeStyle = '#F59E0B'; // Amber for angles
            ctx.lineWidth = 2;
            
            for(let i=0; i<numArcs; i++) {
                ctx.beginPath();
                ctx.arc(p_vertex.x, p_vertex.y, radius + (i*5), start, end);
                ctx.stroke();
            }
        }

        // Main Draw Loop
        // overlapRatio: 0 = separated, 1 = fully overlapped
        function drawTriangles(overlapRatio = isOverlapping ? 1 : 0) {
            ctx.clearRect(0, 0, width, height);

            let a, b, c, ang1, ang2;
            let vertex = null;
            let isValid = true;

            if (currentMode === 'sss') {
                a = parseFloat(s_a.value);
                b = parseFloat(s_b.value);
                c = parseFloat(s_c.value);
                vertex = calcVertexSSS(a, b, c);
                if (!vertex) {
                    err_sss.classList.remove('hidden');
                    isValid = false;
                } else {
                    err_sss.classList.add('hidden');
                }
            } else if (currentMode === 'sas') {
                a = parseFloat(sas_a.value);
                ang1 = parseFloat(sas_angle.value);
                b = parseFloat(sas_b.value);
                vertex = calcVertexSAS(a, ang1, b);
            } else if (currentMode === 'asa') {
                ang1 = parseFloat(asa_ang1.value);
                a = parseFloat(asa_a.value);
                ang2 = parseFloat(asa_ang2.value);
                vertex = calcVertexASA(ang1, a, ang2);
                if (!vertex) {
                    err_asa.classList.remove('hidden');
                    isValid = false;
                } else {
                    err_asa.classList.add('hidden');
                }
            }

            if (!isValid || !vertex) {
                ctx.fillStyle = '#9CA3AF';
                ctx.font = '20px Noto Sans KR';
                ctx.textAlign = 'center';
                ctx.fillText('삼각형이 만들어지지 않는 조건입니다.', width/2, height/2);
                return;
            }

            // Calculations based on mathematical origin (0,0) at bottom-left of Triangle 1
            // We need to translate this to center it nicely on canvas.
            
            // T1 base: (0,0) to (a,0). Top: (vertex.x, vertex.y)
            // Y needs to be inverted for canvas coordinates (0 is top)
            
            // Determine bounding box to center
            const triWidth = Math.max(a, vertex.x);
            const triHeight = vertex.y;
            
            // Separation logic
            const gap = 50; // Gap between triangles when separated
            const totalWidthSeparated = triWidth * 2 + gap;
            
            // Start positions for T1
            let startX1 = (width - totalWidthSeparated) / 2;
            if(startX1 < 20) startX1 = 20; // Padding
            let startY = (height + triHeight) / 2 + 20; // Bottom alignment

            // Positions for T2
            let startX2_target = startX1 + triWidth + gap; // Separated position
            
            // Apply overlap ratio to X2 position
            // When overlapRatio = 1, startX2 = startX1 (fully overlapped)
            // When overlapRatio = 0, startX2 = startX2_target
            let startX2 = startX2_target - (startX2_target - startX1) * overlapRatio;
            
            // If overlapping, center the single overlapped triangle
            if (overlapRatio > 0) {
                 const centerAdjustmentX = ((width - triWidth) / 2) - startX1;
                 startX1 += centerAdjustmentX * overlapRatio;
                 startX2 += centerAdjustmentX * overlapRatio;
            }


            // Points for T1 (ABC)
            const pts1 = [
                {x: startX1, y: startY}, // B
                {x: startX1 + a, y: startY}, // C
                {x: startX1 + vertex.x, y: startY - vertex.y} // A
            ];

            // Points for T2 (DEF)
            const pts2 = [
                {x: startX2, y: startY}, // E
                {x: startX2 + a, y: startY}, // F
                {x: startX2 + vertex.x, y: startY - vertex.y} // D
            ];

            // Draw Triangle 2 (DEF) first so it goes behind if overlapping
            drawTriangle(ctx, pts2, colorT2, strokeT2, ['E', 'F', 'D']);
            
            // Draw Triangle 1 (ABC)
            drawTriangle(ctx, pts1, colorT1, strokeT1, ['B', 'C', 'A']);

            // Draw markings based on condition (Only if not fully overlapped to avoid clutter)
            if (overlapRatio < 0.8) {
                if (currentMode === 'sss') {
                    // Base (a)
                    drawSideMark(ctx, pts1[0], pts1[1], 1);
                    drawSideMark(ctx, pts2[0], pts2[1], 1);
                    // Left (b)
                    drawSideMark(ctx, pts1[0], pts1[2], 2);
                    drawSideMark(ctx, pts2[0], pts2[2], 2);
                    // Right (c)
                    drawSideMark(ctx, pts1[1], pts1[2], 3);
                    drawSideMark(ctx, pts2[1], pts2[2], 3);
                } else if (currentMode === 'sas') {
                    // Base (a)
                    drawSideMark(ctx, pts1[0], pts1[1], 1);
                    drawSideMark(ctx, pts2[0], pts2[1], 1);
                    // Left (b)
                    drawSideMark(ctx, pts1[0], pts1[2], 2);
                    drawSideMark(ctx, pts2[0], pts2[2], 2);
                    // Angle 1 (Bottom Left)
                    drawAngleMark(ctx, pts1[0], pts1[1], pts1[2], 25, 1);
                    drawAngleMark(ctx, pts2[0], pts2[1], pts2[2], 25, 1);
                } else if (currentMode === 'asa') {
                    // Base (a)
                    drawSideMark(ctx, pts1[0], pts1[1], 1);
                    drawSideMark(ctx, pts2[0], pts2[1], 1);
                    // Angle 1 (Bottom Left)
                    drawAngleMark(ctx, pts1[0], pts1[1], pts1[2], 25, 1);
                    drawAngleMark(ctx, pts2[0], pts2[1], pts2[2], 25, 1);
                    // Angle 2 (Bottom Right) - Order of p1, p2 matters for drawing inside
                    drawAngleMark(ctx, pts1[1], pts1[2], pts1[0], 25, 2);
                    drawAngleMark(ctx, pts2[1], pts2[2], pts2[0], 25, 2);
                }
            }

            // Draw equivalence sign in middle if separated
            if (overlapRatio === 0) {
                ctx.fillStyle = '#6B7280';
                ctx.font = '30px Noto Sans KR';
                ctx.textAlign = 'center';
                const midX = (startX1 + a + startX2) / 2;
                ctx.fillText('≡', midX, startY - (triHeight/2));
            }
        }

        // Initialize
        window.onload = () => {
            resizeCanvas();
        };

    </script>
